    "warehouse_order_fulfillment": {
      "repository": "net421/cloud-warehouse-analytics-lab",
      "commit_sha": "140b076edcb89c3b27c3786887ee17d21494a44d",
      "relation": "analytics.mart_order_fulfillment",
      "grain": "one row per order",
      "source_file": "duckdb_local_simulator/sql/03_marts.sql",
      "git_blob_sha": "f251555d77f2b529265b13881f17e293033eef8c",
      "required_fragments": [
        "create or replace table analytics.mart_order_fulfillment",
        "units_shipped::double / nullif(units_ordered, 0) as unit_fill_rate",
        "case when units_shipped >= units_ordered then 1 else 0 end as complete_order_flag",
        "case when delivery_date <= promised_date then 1 else 0 end as on_time_flag",
        "then 1",
        "end as otif_flag",
        "freight_cost + handling_cost + exception_cost as logistics_cost",
        "logistics_cost / nullif(recognized_revenue, 0) as logistics_cost_pct_revenue"
      ],
      "columns": [
        "order_id", "customer_id", "warehouse", "order_date", "promised_date",
        "units_ordered", "units_shipped", "recognized_revenue", "customer_segment",
        "region", "shipment_id", "carrier", "ship_date", "delivery_date",
        "freight_cost", "handling_cost", "exception_cost", "unit_fill_rate",
        "complete_order_flag", "on_time_flag", "order_lead_time_days",
        "logistics_cost", "otif_flag", "logistics_cost_pct_revenue"
      ],
      "metric_formula_ids": {
        "unit_fill_rate": "ratio_of_sums:units_shipped/units_ordered",
        "complete_order_rate": "average_boolean:is_in_full",
        "on_time_delivery_rate": "average_boolean:is_on_time",
        "otif_rate": "average_boolean:is_otif",
        "revenue": "sum:order_revenue",
        "average_order_cycle_time_days": "average:order_cycle_time_days",
        "total_logistics_cost": "sum:total_logistics_cost",
        "cost_to_serve_pct": "ratio_of_sums:total_logistics_cost/order_revenue"
      },
      "column_aliases": {
        "recognized_revenue": "order_revenue",
        "complete_order_flag": "is_in_full",
        "on_time_flag": "is_on_time",
        "otif_flag": "is_otif",
        "order_lead_time_days": "order_cycle_time_days",
        "logistics_cost": "total_logistics_cost",
        "logistics_cost_pct_revenue": "cost_to_serve_pct"
      }
    }
  }
